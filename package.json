{
  "name": "hutch-alttpr-tracker",
  "productName": "Hutch-ALTTPR Tracker",
  "version": "1.1.20.1023",
  "description": "A Link to the Past Randomizer item and map tracker with autotracking.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "fetch-sni": "node tools/fetch-sni.js",
    "predist": "node tools/fetch-sni.js",
    "predist:win": "node tools/fetch-sni.js win",
    "predist:mac": "node tools/fetch-sni.js mac",
    "predist:linux": "node tools/fetch-sni.js linux"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.5.0"
  },
  "build": {
    "appId": "com.hutch.alttpr-tracker",
    "productName": "Hutch-ALTTPR Tracker",
    "copyright": "Copyright © 2026",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "itemtracker.html",
      "map.html",
      "checklist.html",
      "timer.html",
      "broadcast.html",
      "bcast-settings.html",
      "bcast-sounds.html",
      "mobile.html",
      "announce/**/*",
      "entrances_data.json",
      "onlyadkd.json",
      "logic/**/*",
      "items.css",
      "js/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "items",
        "to": "app/items",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "map",
        "to": "app/map",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "boss",
        "to": "app/boss",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "sni/${os}",
        "to": "sni",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Game"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "electron@41.10.7": true
  }
}
